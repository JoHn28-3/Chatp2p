<Window x:Class="Chatp2pWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatP2P" Height="680" Width="1050"
        Background="{DynamicResource FondApp}">
    <Window.Resources>
        <SolidColorBrush x:Key="FondApp" Color="#EFEAE2"/>
        <SolidColorBrush x:Key="FondPanneau" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FondEntete" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="BulleRecue" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BulleEnvoyee" Color="#D9FDD3"/>
        <SolidColorBrush x:Key="Texte" Color="#111B21"/>
        <SolidColorBrush x:Key="Gris" Color="#667781"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="Bulle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Background" Value="{DynamicResource BulleRecue}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstMoi}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BulleEnvoyee}"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Coches" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Gris}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Lu}" Value="True">
                    <Setter Property="Foreground" Value="#53BDEB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MoiSeul" TargetType="MenuItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstMoi}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Panneau gauche ===== -->
        <Border Background="{DynamicResource FondPanneau}" BorderBrush="#33808080" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Background="{DynamicResource FondEntete}" Height="56">
                    <Button DockPanel.Dock="Right" Content="⚙" FontSize="18" Width="44" ToolTip="Réglages"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource Texte}" Click="BtnReglages_Click"/>
                    <Button DockPanel.Dock="Right" Content="🗄" FontSize="18" Width="44" ToolTip="Archivées"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource Texte}" Click="BtnArchives_Click"/>
                    <TextBlock x:Name="lblTitre" Text="Discussions" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource Texte}" VerticalAlignment="Center" Margin="16,0"/>
                </DockPanel>

                <TextBox x:Name="txtRecherche" Grid.Row="1" Margin="10" Padding="8" FontSize="14"
                 Background="{DynamicResource FondEntete}" Foreground="{DynamicResource Texte}"
                 CaretBrush="{DynamicResource Texte}" ToolTip="Rechercher une discussion"
                 TextChanged="TxtRecherche_TextChanged"/>

                <ListBox x:Name="lstChats" Grid.Row="2" BorderThickness="0"
                 Background="{DynamicResource FondPanneau}"
                 SelectionChanged="LstChats_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Épingler" IsCheckable="True"
                              IsChecked="{Binding Epingle, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="Mettre en sourdine" IsCheckable="True"
                              IsChecked="{Binding Muet, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="Archiver" IsCheckable="True"
                              IsChecked="{Binding Archive, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="Messages éphémères (1 min)" IsCheckable="True"
                              IsChecked="{Binding Ephemere, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="Bloquer" IsCheckable="True"
                              IsChecked="{Binding Bloque, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Supprimer la discussion" Click="ChatSuppr_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46">
                                    <Ellipse Fill="#25D366"/>
                                    <TextBlock Text="{Binding Initiale}" Foreground="White" FontSize="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource Texte}"/>
                                        <TextBlock Text="{Binding Icones}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Apercu}" Foreground="{DynamicResource Gris}"
                             MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#25D366" CornerRadius="10" Padding="7,1"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasNonLus, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding NonLusTexte}" Foreground="White" FontSize="12"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== Panneau droit ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="entete" Background="{DynamicResource FondEntete}" Height="56">
                <Button DockPanel.Dock="Right" x:Name="btnConnecter" Content="Connecter"
                Margin="8" Padding="12,0" Click="BtnConnecter_Click"/>
                <TextBox DockPanel.Dock="Right" x:Name="txtIP" Text="127.0.0.1" Width="120"
                 Margin="0,12" VerticalContentAlignment="Center"
                 Background="{DynamicResource FondPanneau}" Foreground="{DynamicResource Texte}"/>
                <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="12,0,0,0">
                    <Ellipse Fill="#25D366"/>
                    <TextBlock Text="{Binding Initiale}" Foreground="White" FontSize="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Nom, FallbackValue='Aucun contact'}" FontWeight="Bold"
                     FontSize="16" Foreground="{DynamicResource Texte}"/>
                    <TextBlock Text="{Binding StatutTexte}" FontSize="12" Foreground="{DynamicResource Gris}"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource FondApp}">
                <ItemsControl x:Name="icMessages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Bulle}" MouseLeftButtonDown="Bulle_Down">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Répondre" Click="MenuRepondre_Click"/>
                                        <MenuItem Header="Copier" Click="MenuCopier_Click"/>
                                        <MenuItem Header="Modifier" Click="MenuModifier_Click"
                              Style="{StaticResource MoiSeul}"/>
                                        <MenuItem Header="Réagir">
                                            <MenuItem Header="👍" Click="MenuReagir_Click"/>
                                            <MenuItem Header="❤️" Click="MenuReagir_Click"/>
                                            <MenuItem Header="😂" Click="MenuReagir_Click"/>
                                            <MenuItem Header="😮" Click="MenuReagir_Click"/>
                                            <MenuItem Header="😢" Click="MenuReagir_Click"/>
                                            <MenuItem Header="🙏" Click="MenuReagir_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="Message important ★" Click="MenuEtoile_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Supprimer pour moi" Click="MenuSupprMoi_Click"/>
                                        <MenuItem Header="Supprimer pour tous" Click="MenuSupprTous_Click"
                              Style="{StaticResource MoiSeul}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Border Background="#22808080" CornerRadius="6" Padding="6,3" Margin="0,0,0,4"
                          Visibility="{Binding HasReponse, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding Reponse}" Foreground="{DynamicResource Gris}"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                    </Border>
                                    <Image Source="{Binding Image}" MaxWidth="300" MaxHeight="300" Stretch="Uniform"
                         Margin="0,0,0,4"
                         Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding NomFichier, StringFormat='📎 {0}'}"
                             Foreground="{DynamicResource Texte}" FontWeight="SemiBold"
                             Visibility="{Binding HasFichier, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Texte}" TextWrapping="Wrap" FontSize="14"
                             Foreground="{DynamicResource Texte}"/>
                                    <TextBlock Text="{Binding Reaction}" FontSize="16" HorizontalAlignment="Left"
                             Visibility="{Binding HasReaction, Converter={StaticResource BoolVis}}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Pied}" FontSize="10"
                               Foreground="{DynamicResource Gris}"/>
                                        <TextBlock Text="{Binding Statut}" FontSize="11" Margin="4,0,0,0"
                               Style="{StaticResource Coches}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="bandeau" Grid.Row="2" Background="{DynamicResource FondEntete}"
              Padding="12,6" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✖" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource Texte}" Click="BtnAnnulerContexte_Click"/>
                    <TextBlock x:Name="txtBandeau" Foreground="{DynamicResource Gris}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="3" Background="{DynamicResource FondEntete}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="😊" FontSize="20" Width="44" Background="Transparent"
                BorderThickness="0" Click="BtnEmoji_Click"/>
                <Button Grid.Column="1" Content="📎" FontSize="20" Width="44" Background="Transparent"
                BorderThickness="0" Click="BtnFichier_Click"/>
                <TextBox x:Name="txtMessage" Grid.Column="2" Margin="4,10" Padding="8" FontSize="14"
                 Background="{DynamicResource FondPanneau}" Foreground="{DynamicResource Texte}"
                 CaretBrush="{DynamicResource Texte}"
                 KeyDown="TxtMessage_KeyDown" TextChanged="TxtMessage_TextChanged"/>
                <Button Grid.Column="3" Content="➤" FontSize="20" Width="44" Background="Transparent"
                BorderThickness="0" Foreground="#25D366" Click="BtnEnvoyer_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>