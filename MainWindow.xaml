<Window x:Class="Chatp2pWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatP2P Desktop" Height="740" Width="1220" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Fenetre_Drop"
        Background="{DynamicResource FondApp}">
    <Window.Resources>
        <SolidColorBrush x:Key="FondApp" Color="#EFEAE2"/>
        <SolidColorBrush x:Key="FondRail" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="FondPanneau" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FondEntete" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="FondSaisie" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FondHover" Color="#F5F6F6"/>
        <SolidColorBrush x:Key="FondSelect" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="Separateur" Color="#E9EDEF"/>
        <SolidColorBrush x:Key="BulleRecue" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BulleEnvoyee" Color="#D9FDD3"/>
        <SolidColorBrush x:Key="Texte" Color="#111B21"/>
        <SolidColorBrush x:Key="Gris" Color="#667781"/>
        <SolidColorBrush x:Key="Accent" Color="#00A884"/>
        <SolidColorBrush x:Key="AccentHover" Color="#128C7E"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="BtnIcone" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Gris}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="19"/>
                            <Border x:Name="survol" Background="#22808080" CornerRadius="19" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="survol" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Champ" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FondSaisie}"/>
            <Setter Property="Foreground" Value="{DynamicResource Texte}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Texte}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Gris}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource FondEntete}" CornerRadius="14" Padding="11,5">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LigneChat" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="10,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource FondHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource FondSelect}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Bulle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="16,3,64,3"/>
            <Setter Property="MaxWidth" Value="470"/>
            <Setter Property="Background" Value="{DynamicResource BulleRecue}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstMoi}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BulleEnvoyee}"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Margin" Value="64,3,16,3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Supprime}" Value="True">
                    <Setter Property="Opacity" Value="0.65"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Coches" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Gris}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Lu}" Value="True">
                    <Setter Property="Foreground" Value="#53BDEB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MoiSeul" TargetType="MenuItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstMoi}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="340" MinWidth="250" MaxWidth="480"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═════ COLONNE 0 : Rail de navigation WhatsApp ═════ -->
        <Border Background="{DynamicResource FondRail}" BorderBrush="{DynamicResource Separateur}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="0,10">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Button x:Name="btnNavChats" Style="{StaticResource BtnIcone}" Content="💬" ToolTip="Discussions"
                            Background="{DynamicResource Accent}" Foreground="White" Click="NavChats_Click"/>
                    <Button x:Name="btnNavAppels" Style="{StaticResource BtnIcone}" Content="📞" ToolTip="Appels"
                            Margin="2,6,2,2" Click="NavAppels_Click"/>
                    <Button x:Name="btnNavStatuts" Style="{StaticResource BtnIcone}" Content="⭕" ToolTip="Statuts / Actus (24h)"
                            Margin="2,6,2,2" Click="NavStatuts_Click"/>
                    <Button Style="{StaticResource BtnIcone}" Content="👥" ToolTip="Créer un groupe"
                            Margin="2,6,2,2" Click="BtnGroupe_Click"/>
                    <Button Style="{StaticResource BtnIcone}" Content="📡" ToolTip="Découvrir sur le réseau local (LAN)"
                            Margin="2,6,2,2" Click="BtnDiscovery_Click"/>
                    <Separator Margin="8,8" Background="{DynamicResource Separateur}"/>
                    <Button Style="{StaticResource BtnIcone}" Content="⭐" ToolTip="Messages importants"
                            Click="BtnImportants_Click"/>
                    <Button x:Name="btnNavArchives" Style="{StaticResource BtnIcone}" Content="🗄" ToolTip="Discussions archivées"
                            Margin="2,6,2,2" Click="BtnArchives_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BtnIcone}" Content="🌓" ToolTip="Basculer thème clair / sombre"
                            Margin="2,0,2,6" Click="BtnTheme_Click"/>
                    <Button Style="{StaticResource BtnIcone}" Content="⚙" ToolTip="Réglages"
                            Margin="2,0,2,10" Click="BtnReglages_Click"/>
                    <Grid Width="36" Height="36" Cursor="Hand" ToolTip="Mon profil et réglages" MouseLeftButtonUp="BtnReglages_Click">
                        <Ellipse Fill="{DynamicResource Accent}"/>
                        <Ellipse x:Name="photoMonAvatar" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="brushMonAvatar" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="lblMonInitiale" Text="M" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════ COLONNE 1 : Panneau gauche (Discussions / Appels / Statuts) ═════ -->
        <Border Grid.Column="1" Background="{DynamicResource FondPanneau}" BorderBrush="{DynamicResource Separateur}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Height="58">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="＋" FontSize="22"
                            ToolTip="Nouvelle discussion par IP" Margin="0,0,6,0" Click="BtnNouveau_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="👥"
                            ToolTip="Nouveau groupe" Click="BtnGroupe_Click"/>
                    <TextBlock x:Name="lblTitre" Text="Discussions" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Texte}" VerticalAlignment="Center" Margin="16,0"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="10,0,10,8">
                    <TextBox x:Name="txtRecherche" Style="{StaticResource Champ}" Background="{DynamicResource FondEntete}"
                             TextChanged="TxtRecherche_TextChanged"/>
                    <TextBlock Text="🔍  Rechercher..." Foreground="{DynamicResource Gris}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="14,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtRecherche}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel x:Name="pnlFiltres" Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,8">
                    <RadioButton x:Name="chipToutes" Style="{StaticResource Chip}" Content="Toutes" IsChecked="True" Click="FiltreChip_Click"/>
                    <RadioButton x:Name="chipNonLus" Style="{StaticResource Chip}" Content="Non lues" Click="FiltreChip_Click"/>
                    <RadioButton x:Name="chipFavoris" Style="{StaticResource Chip}" Content="Favoris" Click="FiltreChip_Click"/>
                    <RadioButton x:Name="chipGroupes" Style="{StaticResource Chip}" Content="Groupes" Click="FiltreChip_Click"/>
                </StackPanel>

                <!-- Vue 1 : Liste des discussions -->
                <ListBox x:Name="lstChats" Grid.Row="3" BorderThickness="0" Background="{DynamicResource FondPanneau}"
                         ItemContainerStyle="{StaticResource LigneChat}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="LstChats_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="⭐ Favori" IsCheckable="True" IsChecked="{Binding Favori, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="📌 Épingler" IsCheckable="True" IsChecked="{Binding Epingle, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="🔇 Mettre en sourdine" IsCheckable="True" IsChecked="{Binding Muet, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="🗄 Archiver" IsCheckable="True" IsChecked="{Binding Archive, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="⏱ Messages éphémères (1 min)" IsCheckable="True" IsChecked="{Binding Ephemere, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <MenuItem Header="⛔ Bloquer" IsCheckable="True" IsChecked="{Binding Bloque, Mode=TwoWay}" Click="ChatMenu_Click"/>
                                        <Separator/>
                                        <MenuItem Header="🗑 Supprimer la discussion" Click="ChatSuppr_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <Ellipse Fill="{Binding Couleur}"/>
                                    <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolVis}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Initiale}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding PasAvatar, Converter={StaticResource BoolVis}}"/>
                                    <Ellipse Width="12" Height="12" Fill="#25D366" Stroke="{DynamicResource FondPanneau}" StrokeThickness="2"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Visibility="{Binding EnLigne, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Texte}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        <TextBlock Text="{Binding Icones}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Apercu}" Foreground="{DynamicResource Gris}" Margin="0,2,0,0"
                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding HeureDerniere}" FontSize="11" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Gris}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNonLus}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Background="{DynamicResource Accent}" CornerRadius="10" Padding="7,1" Margin="0,4,0,0"
                                            HorizontalAlignment="Right" Visibility="{Binding HasNonLus, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding NonLusTexte}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Vue 2 : Historique des appels -->
                <ListBox x:Name="lstAppels" Grid.Row="3" BorderThickness="0" Background="{DynamicResource FondPanneau}"
                         ItemContainerStyle="{StaticResource LigneChat}" Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource FondEntete}">
                                    <TextBlock Text="{Binding IconeType}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Texte}"/>
                                    <TextBlock FontSize="12" Foreground="{Binding CouleurStatut}">
                                        <Run Text="{Binding DirectionTexte, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding DureeTexte, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DateTexte}" FontSize="11" Foreground="{DynamicResource Gris}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource BtnIcone}" Content="📞" Width="32" Height="32" FontSize="14"
                                            ToolTip="Rappeler en audio" Click="BtnRappelerAudio_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Vue 3 : Statuts / Stories (24h) -->
                <Grid x:Name="pnlStatuts" Grid.Row="3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource BtnAction}" Content="＋ Publier un statut (24h)" Margin="12,4,12,10"
                            Click="BtnPublierStatut_Click"/>
                    <ListBox x:Name="lstStatuts" Grid.Row="1" BorderThickness="0" Background="{DynamicResource FondPanneau}"
                             ItemContainerStyle="{StaticResource LigneChat}" MouseDoubleClick="LstStatuts_Click"
                             SelectionChanged="LstStatuts_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="24" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Padding="2">
                                        <Grid>
                                            <Ellipse Fill="{Binding CouleurFond}"/>
                                            <Ellipse Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Initiale}" Foreground="White" FontWeight="Bold" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Auteur}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Texte}"/>
                                        <TextBlock Text="{Binding HeureTexte}" FontSize="12" Foreground="{DynamicResource Gris}"/>
                                        <TextBlock Text="{Binding Texte}" FontSize="12" Foreground="{DynamicResource Gris}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Barre de connexion rapide par IP -->
                <Border Grid.Row="4" Background="{DynamicResource FondEntete}" BorderBrush="{DynamicResource Separateur}"
                        BorderThickness="0,1,0,0" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtIP" Style="{StaticResource Champ}" Text="127.0.0.1" Padding="10,6" FontSize="13"
                                 ToolTip="Adresse IP du contact"/>
                        <TextBox x:Name="txtPort" Grid.Column="1" Style="{StaticResource Champ}" Text="5000" Margin="4,0" Padding="8,6"
                                 FontSize="13" ToolTip="Port"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnAction}" Content="Connecter" Padding="12,6" FontSize="12"
                                Click="BtnConnecter_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Separateur}"/>

        <!-- ═════ COLONNE 3 : Zone de discussion centrale ═════ -->
        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête de la discussion -->
            <DockPanel x:Name="entete" Background="{DynamicResource FondEntete}" Height="60">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="⋮" FontSize="20" ToolTip="Menu" Margin="0,0,8,0" Click="BtnMenuChat_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="ℹ" ToolTip="Infos du contact" Click="BtnToggleInfos_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="🔍" ToolTip="Rechercher dans la discussion (Ctrl+F)" Click="BtnRechChat_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="📞" ToolTip="Appel audio" Click="BtnAppelAudio_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="📹" ToolTip="Appel vidéo" Click="BtnAppelVideo_Click"/>

                <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="EnteteContact_Click">
                    <Grid Width="42" Height="42" Margin="14,0,0,0">
                        <Ellipse Fill="{Binding Couleur}"/>
                        <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolVis}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding Initiale}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding PasAvatar, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nom, FallbackValue='Aucun contact'}" FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource Texte}"/>
                        <TextBlock Text="{Binding StatutTexte}" FontSize="12" Foreground="{DynamicResource Gris}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Bandeau message épinglé -->
            <Border x:Name="bandeauEpingle" Grid.Row="1" Background="{DynamicResource FondPanneau}"
                    BorderBrush="{DynamicResource Separateur}" BorderThickness="0,1,0,1" Padding="14,6"
                    Visibility="{Binding HasMessageEpingle, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="✖" Width="28" Height="28" FontSize="12"
                            ToolTip="Désépingler" Click="BtnDesepingler_Click"/>
                    <TextBlock Text="📌 " Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MessageEpingleTexte}" Foreground="{DynamicResource Texte}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13"/>
                </DockPanel>
            </Border>

            <!-- Barre recherche interne (Ctrl+F) -->
            <Border x:Name="barreRech" Grid.Row="2" Background="{DynamicResource FondPanneau}" Padding="10,6" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="✖" Width="32" Height="32" FontSize="14" Click="BtnFermerRech_Click"/>
                    <TextBox x:Name="txtRechChat" Style="{StaticResource Champ}" Background="{DynamicResource FondEntete}"
                             TextChanged="TxtRechChat_TextChanged"/>
                </DockPanel>
            </Border>

            <!-- Fil des messages -->
            <ScrollViewer x:Name="scroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="{DynamicResource FondApp}">
                <StackPanel>
                    <Border HorizontalAlignment="Center" Background="{DynamicResource FondEntete}" CornerRadius="8"
                            Padding="12,5" Margin="16,12,16,4">
                        <TextBlock Text="🔒 Les messages et appels sont sécurisés en pair-à-pair direct (sans serveur)."
                                   FontSize="11.5" Foreground="{DynamicResource Gris}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <ItemsControl x:Name="icMessages" Margin="0,4,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border HorizontalAlignment="Center" Background="{DynamicResource FondEntete}" CornerRadius="8"
                                            Padding="12,4" Margin="0,10,0,6"
                                            Visibility="{Binding AfficherJour, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding Jour}" FontSize="12" Foreground="{DynamicResource Gris}"/>
                                    </Border>

                                    <Border Style="{StaticResource Bulle}" MouseLeftButtonDown="Bulle_Down">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="↩ Répondre" Click="MenuRepondre_Click"/>
                                                <MenuItem Header="📋 Copier" Click="MenuCopier_Click"/>
                                                <MenuItem Header="📌 Épingler / Désépingler" Click="MenuEpingler_Click"/>
                                                <MenuItem Header="📤 Transférer…" Click="MenuTransferer_Click"/>
                                                <MenuItem Header="✏ Modifier" Click="MenuModifier_Click" Style="{StaticResource MoiSeul}"/>
                                                <MenuItem Header="😊 Réagir">
                                                    <MenuItem Header="👍" Click="MenuReagir_Click"/>
                                                    <MenuItem Header="❤️" Click="MenuReagir_Click"/>
                                                    <MenuItem Header="😂" Click="MenuReagir_Click"/>
                                                    <MenuItem Header="😮" Click="MenuReagir_Click"/>
                                                    <MenuItem Header="😢" Click="MenuReagir_Click"/>
                                                    <MenuItem Header="🙏" Click="MenuReagir_Click"/>
                                                    <MenuItem Header="🔥" Click="MenuReagir_Click"/>
                                                    <MenuItem Header="🎉" Click="MenuReagir_Click"/>
                                                </MenuItem>
                                                <MenuItem Header="⭐ Message important" Click="MenuEtoile_Click"/>
                                                <MenuItem Header="ℹ Infos du message" Click="MenuInfos_Click"/>
                                                <MenuItem Header="📂 Ouvrir dans l'Explorateur" Click="MenuOuvrirDossier_Click"/>
                                                <Separator/>
                                                <MenuItem Header="🗑 Supprimer pour moi" Click="MenuSupprMoi_Click"/>
                                                <MenuItem Header="🗑 Supprimer pour tous" Click="MenuSupprTous_Click" Style="{StaticResource MoiSeul}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <StackPanel>
                                            <!-- Nom auteur dans un groupe -->
                                            <TextBlock Text="{Binding Auteur}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{DynamicResource Accent}" Margin="0,0,0,2"
                                                       Visibility="{Binding HasAuteur, Converter={StaticResource BoolVis}}"/>

                                            <TextBlock Text="↪ Transféré" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Gris}"
                                                       Margin="0,0,0,2" Visibility="{Binding Transfere, Converter={StaticResource BoolVis}}"/>

                                            <!-- Réponse citée -->
                                            <Border Background="#22808080" CornerRadius="6" Padding="8,4" Margin="0,0,0,5"
                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                                                    Visibility="{Binding HasReponse, Converter={StaticResource BoolVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ReponseDe}" FontWeight="SemiBold" FontSize="11"
                                                               Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock Text="{Binding Reponse}" Foreground="{DynamicResource Gris}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="360" FontSize="12.5"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Image -->
                                            <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="320" Stretch="Uniform"
                                                   Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="Image_Click"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>

                                            <!-- Fichier / Document / Audio / Vidéo -->
                                            <Border Background="#1A00A884" CornerRadius="8" Padding="10,8" Margin="0,0,0,4"
                                                    Cursor="Hand" MouseLeftButtonUp="Fichier_Click"
                                                    Visibility="{Binding HasFichier, Converter={StaticResource BoolVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IconeFichier}" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NomFichier}" Foreground="{DynamicResource Texte}"
                                                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TailleAffichee}" Foreground="{DynamicResource Gris}" FontSize="11.5"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Lecteur de message vocal intégré -->
                                            <Border Background="#1A00A884" CornerRadius="10" Padding="8,6" Margin="0,0,0,4" MinWidth="240"
                                                    Visibility="{Binding EstVocal, Converter={StaticResource BoolVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource BtnIcone}" Content="{Binding BoutonLecture}"
                                                            Background="{DynamicResource Accent}" Foreground="White" Width="34" Height="34" FontSize="14"
                                                            Click="BtnLireVocal_Click"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                        <ProgressBar Value="{Binding ProgressionLecture}" Minimum="0" Maximum="100"
                                                                     Height="5" Foreground="{DynamicResource Accent}" Background="#33808080"/>
                                                        <TextBlock Text="{Binding DureeVocaleTexte}" FontSize="11" Foreground="{DynamicResource Gris}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="{Binding VitesseLecture}" FontSize="11" FontWeight="Bold"
                                                            Padding="7,3" Background="#22808080" Foreground="{DynamicResource Texte}"
                                                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                                            Click="BtnVitesseVocal_Click"/>
                                                </Grid>
                                            </Border>

                                            <!-- Sondage interactif -->
                                            <StackPanel MinWidth="250" Visibility="{Binding EstSondage, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding QuestionSondage}" FontWeight="Bold" FontSize="14.5"
                                                           Foreground="{DynamicResource Texte}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding OptionsSondage}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Margin="0,3" Padding="0" Background="Transparent" BorderThickness="0"
                                                                    HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                                    Click="BtnVoterSondage_Click">
                                                                <Border Background="#1A808080" CornerRadius="8" Padding="8,6">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PourcentageTexte}"
                                                                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                                            <TextBlock Foreground="{DynamicResource Texte}" FontSize="13">
                                                                                <Run Text="{Binding PrefixeVote, Mode=OneWay}"/>
                                                                                <Run Text="{Binding Texte, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                        </DockPanel>
                                                                        <ProgressBar Value="{Binding Pourcentage, Mode=OneWay}" Minimum="0" Maximum="100"
                                                                                     Height="4" Margin="0,4,0,2" Foreground="{DynamicResource Accent}" Background="#22808080"/>
                                                                        <TextBlock Text="{Binding VotantsTexte}" FontSize="10.5" Foreground="{DynamicResource Gris}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding TotalVotesTexte}" FontSize="11" Foreground="{DynamicResource Gris}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <ProgressBar Value="{Binding Progression}" Minimum="0" Maximum="100" Height="4" Margin="0,0,0,4"
                                                         Foreground="{DynamicResource Accent}"
                                                         Visibility="{Binding EnTransfert, Converter={StaticResource BoolVis}}"/>

                                            <!-- Texte -->
                                            <TextBlock Text="{Binding Texte}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Texte}"
                                                       Visibility="{Binding HasTexte, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="🚫 Ce message a été supprimé" FontStyle="Italic" FontSize="13"
                                                       Foreground="{DynamicResource Gris}"
                                                       Visibility="{Binding Supprime, Converter={StaticResource BoolVis}}"/>

                                            <!-- Réaction -->
                                            <Border HorizontalAlignment="Left" Margin="0,4,0,0" Background="#22808080"
                                                    CornerRadius="10" Padding="5,1"
                                                    Visibility="{Binding HasReaction, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding Reaction}" FontSize="15"/>
                                            </Border>

                                            <!-- Heure + coches -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Pied}" FontSize="10.5" Foreground="{DynamicResource Gris}"/>
                                                <TextBlock Text="{Binding Statut}" FontSize="11" Margin="4,0,0,0" Style="{StaticResource Coches}"
                                                           Visibility="{Binding EstMoi, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Bandeau Répondre / Modifier -->
            <Border x:Name="bandeau" Grid.Row="4" Background="{DynamicResource FondEntete}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="4,0,0,0" Padding="12,6" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcone}" Content="✖" Width="30" Height="30" FontSize="13" Click="BtnAnnulerContexte_Click"/>
                    <TextBlock x:Name="txtBandeau" Foreground="{DynamicResource Gris}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Barre de saisie + Barre d'enregistrement vocal -->
            <Grid Grid.Row="5" Background="{DynamicResource FondEntete}">
                <Grid x:Name="pnlSaisie">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BtnIcone}" Content="😊" FontSize="20" ToolTip="Emojis" Margin="8,2,2,2" Click="BtnEmoji_Click"/>
                    <Button Grid.Column="1" Style="{StaticResource BtnIcone}" Content="📎" FontSize="20"
                            ToolTip="Joindre (Image, Document, Sondage, Capture)" Click="BtnJoindre_Click"/>
                    <TextBox x:Name="txtMessage" Grid.Column="2" Style="{StaticResource Champ}" Margin="4,10"
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="TxtMessage_KeyDown" TextChanged="TxtMessage_TextChanged"/>
                    <Button Grid.Column="3" Style="{StaticResource BtnIcone}" Content="🎤" FontSize="20"
                            ToolTip="Enregistrer un message vocal" Click="BtnVocal_Click"/>
                    <Button Grid.Column="4" Style="{StaticResource BtnIcone}" Content="➤" FontSize="18" Foreground="White"
                            Background="{DynamicResource Accent}" ToolTip="Envoyer (Entrée)" Margin="2,2,10,2" Click="BtnEnvoyer_Click"/>
                </Grid>

                <DockPanel x:Name="pnlEnregistrement" Visibility="Collapsed" Margin="12,10">
                    <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcone}" Content="🗑" ToolTip="Annuler le vocal"
                            Foreground="#EF5350" Click="BtnAnnulerVocal_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnAction}" Content="✅ Envoyer le vocal"
                            Click="BtnEnvoyerVocal_Click"/>
                    <TextBlock x:Name="lblRecTemps" Text="🔴 Enregistrement… 00:00" FontSize="15" FontWeight="SemiBold"
                               Foreground="#EF5350" VerticalAlignment="Center" Margin="16,0"/>
                </DockPanel>
            </Grid>

            <!-- Écran d'accueil -->
            <Grid x:Name="accueil" Grid.RowSpan="6" Background="{DynamicResource FondEntete}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="💬" FontSize="72" HorizontalAlignment="Center"/>
                    <TextBlock Text="ChatP2P Desktop" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Texte}"
                               HorizontalAlignment="Center" Margin="0,12,0,8"/>
                    <TextBlock Text="WhatsApp P2P local : discussions, groupes, messages vocaux, appels audio/vidéo, sondages, statuts 24h et partage de fichiers."
                               Foreground="{DynamicResource Gris}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13.5"/>
                    <TextBlock x:Name="lblMonReseau" Text="En écoute…" Foreground="{DynamicResource Accent}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource BtnAction}" Content="＋ Connexion IP" Margin="0,0,8,0" Click="BtnNouveau_Click"/>
                        <Button Style="{StaticResource BtnAction}" Content="📡 Scanner le LAN" Margin="0,0,8,0" Click="BtnDiscovery_Click"/>
                        <Button Style="{StaticResource BtnAction}" Content="👥 Créer un groupe" Click="BtnGroupe_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═════ COLONNE 4 : Panneau droit pliable (Infos contact / groupe) ═════ -->
        <Border x:Name="pnlInfos" Grid.Column="4" Width="300" Visibility="Collapsed"
                Background="{DynamicResource FondPanneau}" BorderBrush="{DynamicResource Separateur}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Height="60" Background="{DynamicResource FondEntete}">
                    <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcone}" Content="✖" Margin="8,0,4,0" Click="BtnToggleInfos_Click"/>
                    <TextBlock Text="Infos du contact" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Texte}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Grid Width="92" Height="92" HorizontalAlignment="Center" Margin="0,8,0,12">
                            <Ellipse Fill="{Binding Couleur}"/>
                            <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding Initiale}" Foreground="White" FontSize="36" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding PasAvatar, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Nom}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Texte}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatutTexte}" FontSize="12.5" Foreground="{DynamicResource Gris}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Button Style="{StaticResource BtnAction}" Content="📞 Audio" Margin="4" Padding="10,6" FontSize="12" Click="BtnAppelAudio_Click"/>
                            <Button Style="{StaticResource BtnAction}" Content="📹 Vidéo" Margin="4" Padding="10,6" FontSize="12" Click="BtnAppelVideo_Click"/>
                            <Button Style="{StaticResource BtnAction}" Content="🔍 Chercher" Margin="4" Padding="10,6" FontSize="12" Click="BtnRechChat_Click"/>
                        </StackPanel>

                        <Border Background="{DynamicResource FondEntete}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Actu / Bio" FontSize="11" Foreground="{DynamicResource Gris}"/>
                                <TextBlock Text="{Binding Bio}" FontSize="13.5" Foreground="{DynamicResource Texte}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="Adresse IP P2P" FontSize="11" Foreground="{DynamicResource Gris}"/>
                                <TextBlock Text="{Binding Ip}" FontSize="13" Foreground="{DynamicResource Texte}" Margin="0,2,0,8"/>
                                <TextBlock Text="🔒 Code de sécurité" FontSize="11" Foreground="{DynamicResource Gris}"/>
                                <TextBlock Text="{Binding EmpreinteSecurite}" FontSize="11.5" FontFamily="Consolas"
                                           Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Membres du groupe -->
                        <Border Background="{DynamicResource FondEntete}" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                Visibility="{Binding EstGroupe, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Membres du groupe" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Membres}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='👤 {0}'}" Foreground="{DynamicResource Texte}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Interrupteurs contact -->
                        <CheckBox Content="⭐ Ajouter aux favoris" IsChecked="{Binding Favori, Mode=TwoWay}" Foreground="{DynamicResource Texte}" Margin="0,4" Click="ChatMenu_Click"/>
                        <CheckBox Content="📌 Épingler la discussion" IsChecked="{Binding Epingle, Mode=TwoWay}" Foreground="{DynamicResource Texte}" Margin="0,4" Click="ChatMenu_Click"/>
                        <CheckBox Content="🔇 Notifications en sourdine" IsChecked="{Binding Muet, Mode=TwoWay}" Foreground="{DynamicResource Texte}" Margin="0,4" Click="ChatMenu_Click"/>
                        <CheckBox Content="⏱ Messages éphémères (1 min)" IsChecked="{Binding Ephemere, Mode=TwoWay}" Foreground="{DynamicResource Texte}" Margin="0,4" Click="ChatMenu_Click"/>
                        <CheckBox Content="⛔ Bloquer ce contact" IsChecked="{Binding Bloque, Mode=TwoWay}" Foreground="#EF5350" Margin="0,4,0,12" Click="ChatMenu_Click"/>

                        <TextBlock Text="Médias &amp; documents partagés" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gris}" Margin="0,0,0,6"/>
                        <ListBox x:Name="lstMediasPartages" MaxHeight="140" BorderThickness="0" Background="{DynamicResource FondEntete}"
                                 Foreground="{DynamicResource Texte}" MouseDoubleClick="LstMediasPartages_Click" Margin="0,0,0,14"/>

                        <Button Style="{StaticResource BtnAction}" Content="📤 Exporter la discussion (.txt)" Margin="0,0,0,8" Click="BtnExporter_Click"/>
                        <Button Content="🗑 Vider la discussion" Background="#E53935" Foreground="White" Padding="10,7" BorderThickness="0"
                                Cursor="Hand" Click="BtnViderChat_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
